{
  "name": "opencode-workspace",
  "version": "0.2.5",
  "description": "A workspace & file editor panel for OpenCode Desktop: tabs, autosave, external-change protection, Markdown preview, and tree shortcuts.",
  "type": "module",
  "author": "jekverse",
  "files": [
    "index.ts",
    "gui-experimental.cjs",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "workspace",
    "editor",
    "file-editor",
    "markdown",
    "desktop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jekverse/jek-opencode-plugin.git"
  },
  "homepage": "https://github.com/jekverse/jek-opencode-plugin#readme",
  "bugs": {
    "url": "https://github.com/jekverse/jek-opencode-plugin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build:tests": "node scripts/build-tests.mjs",
    "pretest": "npm run build",
    "test": "npm run build:tests && node --test \"test/*.test.mjs\"",
    "verify:live": "node scripts/verify-live.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@lezer/highlight": "^1.2.5",
    "@opencode/plugin": "^2.3.2",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
